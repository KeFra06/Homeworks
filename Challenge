FUNCION NORMAL PARA VER SI UN NUMERO ES PAR O NO 

function verificarSiEsPar(num) {
  if (num % 2 === 0) {
    console.log(`el numero ${num} es par`);
  } else {
    console.log(`el numero ${num} es impar`);
  }
};

FUNCION FLECHA PARA VER SI UN NUMERO ES PAR O NO 

const verificarSiEsParFlecha = (num) => {
  if (num % 2 === 0) {
    console.log(`el numero ${num} es par`);
  } else {
    console.log(`el numero ${num} es impar`);
  }
};
